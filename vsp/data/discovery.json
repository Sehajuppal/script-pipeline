 "KEYWORD_RULES": {
  "primary": {
   "count": 1,
   "words": {
    "min": 2,
    "max": 4
   },
   "form": "lowercase search phrase, singular head noun, no brand unless owned",
   "match": "exact phrase, or all content-word lemmas present (order-free); pronouns never count",
   "placement": {
    "spoken": {
     "by_s": 3.0,
     "min": 1,
     "max_per_30s": 3
    },
    "on_screen": {
     "by_s": 3.0,
     "min_duration_s": 1.0,
     "max_words": 4,
     "box_1080x1920": {
      "x": [
       120,
       888
      ],
      "y": [
       288,
       1248
      ]
     },
     "max_cards_with_keyword": 2
    },
    "caption_first_line": {
     "within_chars": 60,
     "line_max_chars": {
      "tiktok": 100,
      "instagram": 125
     }
    },
    "yt_title": {
     "within_chars": 40
    },
    "alt_text_substitute": "one literal description sentence containing the keyword once",
    "cover_text": {
     "contains": "head noun",
     "max_words": 5
    },
    "hashtag": "exactly one hashtag = primary keyword without spaces"
   }
  },
  "secondary": {
   "max": 2,
   "placement": [
    "caption line 2 or YT description",
    "optional one hashtag each",
    "optional one spoken mention in body",
    "TikTok Manage Keywords suggestions"
   ]
  },
  "density": {
   "caption_primary_exact_max": 2,
   "caption_plus_hashtags_same_stem_max": 3,
   "hashtags_off_topic_max": 0,
   "banned_filler_tags": [
    "#fyp",
    "#foryou",
    "#foryoupage",
    "#viral",
    "#trending",
    "#explorepage",
    "#shorts"
   ],
   "yt_description_rules": [
    "no tag lists",
    "no repeated sentences"
   ],
   "manage_keywords_suggest_max": 3
  },
  "intent_templates": [
   {
    "template": "{product} review",
    "formats": [
     "review"
    ],
    "hook_families": [
     "transformation",
     "question",
     "proof-first"
    ]
   },
   {
    "template": "is {product} worth it",
    "formats": [
     "review"
    ],
    "hook_families": [
     "question",
     "curiosity-gap"
    ]
   },
   {
    "template": "{product} vs {alternative}",
    "formats": [
     "review",
     "demo"
    ],
    "hook_families": [
     "comparison"
    ],
    "requires": "real side-by-side footage; factual only"
   },
   {
    "template": "how to use {product}",
    "formats": [
     "demo"
    ],
    "hook_families": [
     "showcase",
     "listicle"
    ]
   },
   {
    "template": "what to know before buying {product}",
    "formats": [
     "demo",
     "review"
    ],
    "hook_families": [
     "negative-command",
     "problem-agitate"
    ]
   },
   {
    "template": "{product} mistakes",
    "formats": [
     "demo"
    ],
    "hook_families": [
     "negative-command",
     "contrarian-reframe"
    ]
   },
   {
    "template": "does {product} work",
    "formats": [
     "review",
     "demo"
    ],
    "hook_families": [
     "proof-first",
     "question"
    ]
   },
   {
    "template": "{category} hack",
    "formats": [
     "demo"
    ],
    "hook_families": [
     "showcase",
     "newness"
    ]
   },
   {
    "template": "{product} for {use}",
    "formats": [
     "demo",
     "review"
    ],
    "hook_families": [
     "problem-agitate",
     "pov"
    ]
   },
   {
    "template": "best {category} for {use}",
    "formats": [
     "review"
    ],
    "hook_families": [
     "question"
    ],
    "requires": "question/search-label form only, never asserted (D141)"
   },
   {
    "template": "{product} before and after",
    "formats": [
     "review"
    ],
    "hook_families": [
     "transformation",
     "day-counter"
    ],
    "requires": "honest, dated comparison"
   },
   {
    "template": "{category} under ${price}",
    "formats": [
     "review",
     "demo"
    ],
    "hook_families": [
     "price-anchor"
    ],
    "requires": "price supplied (D37)"
   },
   {
    "template": "{n} day {habit} challenge",
    "formats": [
     "pov-vlog"
    ],
    "hook_families": [
     "challenge",
     "day-counter"
    ]
   },
   {
    "template": "quit {thing} for {n} days",
    "formats": [
     "pov-vlog"
    ],
    "hook_families": [
     "challenge",
     "confession"
    ]
   }
  ],
  "selection_rules": [
   "1. Normalize the product noun phrase from the prompt (singular, lowercase, drop brand unless owned); its last noun is the head noun.",
   "2. Expand candidates with intent_templates allowed for the script's format and hook family.",
   "3. Drop candidates that fail guardrails: unsupported superlative claim (D141), price without a supplied price (D37), health/absolute outcomes, competitor names without real footage.",
   "4. Score demand 0-1: research-DB n-gram frequency in the niche's top reels (7-30 d, views-weighted) 0.5 + human-logged autocomplete or Creator Search Insights/YT Trends hit 0.3 + Google Trends (YouTube Search) non-zero 0.2.",
   "5. Add +0.1 if flagged as a content gap (TikTok Creator Search Insights or YT 'content gaps for Shorts').",
   "6. Require that the video actually answers the query (payoff matches intent); otherwise score 0.",
   "7. Tie-break: fewer words, head noun first, natural fit in the existing spoken hook.",
   "8. Pick exactly one primary; take the next two non-overlapping candidates as secondary; store all in the bundle (keyword, source, score)."
  ],
  "soft_rubric": {
   "comment_word_equals_head_noun": "warn if the comment-word is not the head noun (TikTok search suggestions draw on comments) [A]"
  }
 },
 "POSTING_GUIDANCE": [
  {
   "id": "PG1",
   "platform": "all",
   "guidance": "Post shortly before your own audience's active window (TikTok Studio Followers > Most active times; IG app insights; YT 'When your viewers are on YouTube').",
   "label": "evidence-backed",
   "grade": "M",
   "source": "https://buffer.com/resources/when-is-the-best-time-to-post-on-instagram/"
  },
  {
   "id": "PG2",
   "platform": "all",
   "guidance": "A universal 'best time to post' (e.g. Sun 9 am) will lift reach.",
   "label": "myth/weak",
   "grade": "A",
   "source": "https://buffer.com/library/best-time-to-post-on-tiktok/"
  },
  {
   "id": "PG3",
   "platform": "tiktok",
   "guidance": "2-5 posts/week vs 1 raises views/post ~17% by lifting the top decile; the median post doesn't improve.",
