 "GATE_RULES": [
  {
   "id": "DISC-01",
   "name": "keyword_spoken_early",
   "stage": "gate1",
   "severity": "error",
   "check": "primary keyword (exact or all content lemmas) in dialogue whose cue ends <= 3.0 s",
   "threshold": {
    "by_s": 3.0,
    "max_per_30s": 3
   },
   "source": "https://ads.tiktok.com/help/article/creative-best-practices ; https://support.google.com/youtube/answer/16090438?hl=en"
  },
  {
   "id": "DISC-02",
   "name": "keyword_on_screen",
   "stage": "gate2",
   "severity": "error",
   "check": "an on_screen card containing the primary keyword starts <= 3.0 s, lasts >= 1.0 s, <= 4 words, inside x120-888/y288-1248",
   "threshold": {
    "by_s": 3.0,
    "min_s": 1.0
   },
   "source": "https://ads.tiktok.com/resources/help/article/search-ads-creative"
  },
  {
   "id": "DISC-03",
   "name": "caption_first_line",
   "stage": "gate2",
   "severity": "error",
   "check": "primary keyword within the first 60 chars of caption line 1; line 1 <= 100 (TikTok) / 125 (Instagram) chars",
   "threshold": {
    "within_chars": 60
   },
   "source": "https://about.instagram.com/blog/announcements/break-down-how-instagram-search-works/"
  },
  {
   "id": "DISC-04",
   "name": "hashtag_budget_relevance",
   "stage": "gate2",
   "severity": "error",
   "check": "count within platform max (TT 5, IG 5, YT 3); exactly one tag = primary keyword; 0 off-topic or filler tags (token overlap with keywords or niche map)",
   "threshold": {
    "tiktok_max": 5,
    "instagram_max": 5,
    "youtube_max": 3,
    "off_topic_max": 0
   },
   "source": "https://www.socialmediatoday.com/news/instagram-implements-new-limits-on-hashtag-use/808309/ ; https://support.google.com/youtube/answer/6390658?hl=en"
  },
  {
   "id": "DISC-05",
   "name": "no_keyword_stuffing",
   "stage": "gate2",
   "severity": "warn",
   "check": "primary exact <= 2 in caption; same stem <= 3 across caption+hashtags; YT description has no tag lists or repeated sentences",
   "threshold": {
    "caption_exact_max": 2,
    "stem_max": 3
   },
   "source": "https://support.google.com/youtube/answer/6390658?hl=en"
  },
  {
   "id": "DISC-06",
   "name": "platform_hard_limits",
   "stage": "export",
   "severity": "error",
   "check": "TT caption <= 2,200 UTF-16 units; IG caption <= 2,200 chars, <= 20 mentions; YT title <= 100 chars without < >, description <= 5,000 UTF-8 bytes, tags <= 500 chars",
   "threshold": {
    "tt_utf16": 2200,
    "ig_chars": 2200,
    "yt_title": 100,
    "yt_desc_bytes": 5000
   },
   "source": "https://developers.tiktok.com/doc/content-posting-api-reference-direct-post ; https://developers.google.com/youtube/v3/docs/videos"
  },
  {
   "id": "DISC-07",
   "name": "cover_safe",
   "stage": "gate2",
   "severity": "error",
   "check": "cover frame/image designated; cover text <= 5 words, contains head noun, all glyphs inside x120-888/y420-1248",
   "threshold": {
    "max_words": 5,
    "box": {
     "x": [
      120,
      888
     ],
     "y": [
      420,
      1248
     ]
    }
   },
   "source": "https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/reference/ig-user/media/"
  },
  {
   "id": "DISC-08",
   "name": "disclosure_flags",
   "stage": "export",
   "severity": "error",
   "check": "presenter=ai -> TT is_aigc, IG is_ai_generated, YT containsSyntheticMedia all true + caption line (D138); paid -> brand_content_toggle / is_paid_partnership / hasPaidProductPlacement",
   "threshold": {
    "missing_allowed": 0
   },
   "source": "https://developers.facebook.com/docs/instagram-platform/changelog ; https://developers.google.com/youtube/v3/docs/videos"
  },
  {
   "id": "DISC-09",
   "name": "compliance_parity",
   "stage": "gate2",
   "severity": "error",
   "check": "D46 one CTA destination, D139 bait lexicon, D37/D136 numbers and D141 absolutes applied to every platform caption, YT title/description, cover text and description sentence; YT CTA is not a URL",
   "threshold": {
    "cta_destinations_per_platform": 1,
    "violations": 0
   },
   "source": "https://transparency.meta.com/features/approach-to-ranking/content-distribution-guidelines/engagement-bait/"
  },
  {
   "id": "DISC-10",
   "name": "clean_master_and_publish_verify",
   "stage": "publish",
   "severity": "error",
   "check": "no foreign-platform watermark in any master; after IG publish, config_issue must be absent (CAPTION_NOT_ATTACHED -> alert)",
   "threshold": {
    "watermarks": 0,
    "config_issue": "none"
   },
   "source": "https://creators.instagram.com/recommendations-and-originality?locale=en_US ; https://developers.facebook.com/docs/instagram-platform/changelog"
  }
