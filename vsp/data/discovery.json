   "grade": "P",
   "source": "https://www.socialmediatoday.com/news/instagram-implements-new-limits-on-hashtag-use/808309/"
  },
  {
   "id": "PG8",
   "platform": "tiktok",
   "guidance": "#fyp / #foryou / #viral tags push videos to the For You feed.",
   "label": "myth/weak",
   "grade": "A",
   "source": "https://newsroom.tiktok.com/en-us/how-tiktok-recommends-videos-for-you"
  },
  {
