  },
  {
   "id": "PG10",
   "platform": "all",
   "guidance": "Keyword-rich file names improve ranking.",
   "label": "myth/weak",
   "grade": "A",
   "source": "https://support.google.com/youtube/answer/16090438?hl=en"
  },
  {
