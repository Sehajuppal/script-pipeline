{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vsp:schema:script:1",
  "title": "viral_script_maker script",
  "description": "Output of viral_script_maker.generate() — the script.json every pipeline run ships (D152). Additional properties are allowed.",
  "type": "object",
  "required": [
    "prompt",
    "presenter",
    "format",
    "duration_s",
    "niche",
    "hook_stack",
    "beats",
    "caption"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "presenter": {
      "enum": [
        "ai",
        "human"
      ]
    },
    "format": {
      "enum": [
        "demo",
        "talking-head",
        "pov-vlog",
        "transformation",
        "review"
      ]
    },
    "duration_s": {
      "type": "number",
      "minimum": 5,
      "maximum": 180
    },
    "niche": {
      "type": "string",
      "minLength": 1
    },
    "fit": {
      "type": "string"
    },
    "hook_family": {
      "type": "string"
    },
    "hook_source": {
      "enum": [
        "template",
        "fallback",
        "pinned"
      ],
      "description": "D145: what actually rendered"
    },
    "fit_warning": {
      "type": [
        "string",
        "null"
      ]
    },
    "persona": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "styling_rule": {
          "type": "string"
        }
      }
    },
    "hook_stack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hook_item"
      }
    },
    "beats": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/beat"
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "research_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclosure": {
      "type": "string"
    },
    "delivery_note": {
      "type": "string"
    },
    "series_plan": {
      "type": "object",
      "description": "D146: backs a part-2 CTA"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "$defs": {
    "hook_item": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "t": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?\\s*[\\u2013-]\\s*\\d+(?:\\.\\d+)?\\s*s$",
          "description": "time window 'S–Es' (en dash or hyphen), seconds"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "beat type, e.g. VISUAL TRIGGER, EDUCATION BEAT, PAYOFF"
        },
        "dialogue": {
          "type": "string"
        },
        "rehook": {
          "type": "string"
        },
        "on_screen": {
          "type": "string"
        },
        "delivery": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "shot_direction": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "payoff_contract": {
          "type": "string"
        },
        "match_cut": {
          "type": "string"
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "t",
        "type"
      ],
      "properties": {
        "t": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?\\s*[\\u2013-]\\s*\\d+(?:\\.\\d+)?\\s*s$",
          "description": "time window 'S–Es' (en dash or hyphen), seconds"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "beat type, e.g. VISUAL TRIGGER, EDUCATION BEAT, PAYOFF"
        },
        "dialogue": {
          "type": "string"
        },
        "rehook": {
          "type": "string"
        },
        "on_screen": {
          "type": "string"
        },
        "delivery": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "shot_direction": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "payoff_contract": {
          "type": "string"
        },
        "match_cut": {
          "type": "string"
        }
      }
    }
  }
}
